# Cloudflare Pages caching. Three rules, and the reasoning behind each matters
# more than the numbers, because getting one wrong here does not slow the app
# down -- it breaks it.
#
# The manifest is the ONE file that must always be fresh. Everything else is
# reached through it, and it is the thing that says which pack bytes are correct.
# Serve a stale manifest and the app opens a course that no longer exists.
/courses/index.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Packs are immutable because the loader asks for them BY CONTENT: the URL
# carries the sha256 prefix, so changed bytes are a changed URL. This is not
# just an optimisation. The runtime verifies the pack against the manifest's
# hash, so a CDN handing back yesterday's pack under today's manifest would
# throw rather than degrade -- the content-addressed URL is what makes a long
# cache safe at all. 400 KB per course, fetched once, ever.
/courses/*/pack.bin
  Cache-Control: public, max-age=31536000, immutable

# Posters are not content-addressed and they are only decoration, so they get a
# day: long enough that a returning visitor pays nothing, short enough that a
# re-render reaches people without a deploy trick. The glob covers hero-1 and
# every frame the card cycles to -- naming only hero-1 left three quarters of
# the gallery with no rule at all.
/courses/*/hero-*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The opt-in v2 pilot descriptors may advance after a reviewed pilot build, so
# they revalidate for the same reason /courses/index.json does. Their BVCH
# children are immutable full-SHA URLs, verified again after download, and are
# already covered by the /grounds/*/terrain and /grounds/*/surface rules below
# -- the pilot now lists the published graph's own chunks and lives beside it.
#
# These were /v2/*/preview.json and /v2/*/surface-preview.json until the pilot
# widened out of that tree. Nothing has been served from /v2/ since, so those
# rules protected nothing while these two paths had no rule at all: the exact
# staleness the comment above them warns about, with the warning pointing at
# the wrong address.
/grounds/*/preview.json
  Cache-Control: no-cache

/grounds/*/surface-preview.json
  Cache-Control: no-cache

# The v2 asset graph. Its root is the only mutable file in the graph and it is
# what names every hash below, so it must revalidate for exactly the reason
# /courses/index.json does: serve a stale root and the loader resolves a course
# manifest that no longer describes the live pack, and fails closed on the
# fallback-identity check rather than degrading quietly.
/courses/v2-index.json
  Cache-Control: no-cache

# Everything the root points at carries its full SHA-256 in the filename and is
# verified again after download, so a cached copy can never be the wrong bytes
# for its URL.
/courses/*/course-v2-*.json
  Cache-Control: public, max-age=31536000, immutable

/courses/*/routing/*.bvch
  Cache-Control: public, max-age=31536000, immutable

/grounds/*/ground-v2-*.json
  Cache-Control: public, max-age=31536000, immutable

/grounds/*/terrain/*.bvch
  Cache-Control: public, max-age=31536000, immutable

/grounds/*/surface/*.bvch
  Cache-Control: public, max-age=31536000, immutable

/grounds/*/objects/*.bvch
  Cache-Control: public, max-age=31536000, immutable

# Vite content-hashes everything in /assets, so those names already change when
# the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The shell itself must revalidate or a deploy never reaches anyone.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
