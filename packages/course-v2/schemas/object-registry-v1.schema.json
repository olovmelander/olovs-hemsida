{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object-registry-v1.schema.json",
  "title": "Banvy published object registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groundId", "tileId", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groundId": { "$ref": "common-v2.schema.json#/$defs/id" },
    "tileId": { "$ref": "common-v2.schema.json#/$defs/tileId" },
    "records": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "groundId", "class", "subtype", "easting", "northing",
        "heightRH2000", "objectHeightMetres", "radiusMetres", "headingDegrees",
        "sourceId", "capturedAt", "accuracyTier", "horizontalAccuracyMetres",
        "verticalAccuracyMetres", "confidence", "reviewStatus", "truthZone",
        "placementMethod"
      ],
      "properties": {
        "id": { "$ref": "common-v2.schema.json#/$defs/id" },
        "groundId": { "$ref": "common-v2.schema.json#/$defs/id" },
        "class": {
          "enum": [
            "boulder", "building-detail", "bush", "course-furniture",
            "drainage", "fence", "light", "sign", "tree"
          ]
        },
        "subtype": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "common-v2.schema.json#/$defs/id" }
          ]
        },
        "easting": { "type": "number" },
        "northing": { "type": "number" },
        "heightRH2000": { "type": "number" },
        "objectHeightMetres": { "type": "number", "minimum": 0.05, "maximum": 100 },
        "radiusMetres": { "type": "number", "minimum": 0.01, "maximum": 100 },
        "headingDegrees": { "type": "number", "minimum": 0, "maximum": 360 },
        "sourceId": { "$ref": "common-v2.schema.json#/$defs/id" },
        "capturedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z)?$"
        },
        "accuracyTier": { "enum": ["A", "B", "C", "D", "E", "unrated"] },
        "horizontalAccuracyMetres": { "type": "number", "minimum": 0, "maximum": 1000 },
        "verticalAccuracyMetres": { "type": "number", "minimum": 0, "maximum": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewStatus": { "const": "approved" },
        "truthZone": { "enum": ["A", "B", "C"] },
        "placementMethod": {
          "enum": ["derived-lidar", "digitized", "source-constrained-procedural", "survey"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "truthZone": { "const": "A" } },
            "required": ["truthZone"]
          },
          "then": {
            "properties": {
              "accuracyTier": { "enum": ["A", "B", "C"] },
              "placementMethod": {
                "enum": ["derived-lidar", "digitized", "survey"]
              }
            }
          }
        }
      ]
    }
  }
}
