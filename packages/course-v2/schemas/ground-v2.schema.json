{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground-v2.schema.json",
  "title": "Banvy v2 shared physical-ground manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "groundFormat", "groundId", "requiredFeatures",
    "frame", "bounds", "sourceManifestSha256", "shell", "tiles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "groundFormat": { "const": 2 },
    "groundId": { "$ref": "common-v2.schema.json#/$defs/id" },
    "requiredFeatures": { "$ref": "common-v2.schema.json#/$defs/features" },
    "frame": { "$ref": "common-v2.schema.json#/$defs/frame" },
    "bounds": { "$ref": "common-v2.schema.json#/$defs/bounds" },
    "sourceManifestSha256": { "$ref": "common-v2.schema.json#/$defs/sha256" },
    "shell": {
      "allOf": [
        { "$ref": "common-v2.schema.json#/$defs/assetReference" },
        { "type": "object", "properties": { "kind": { "const": "terrain" } } }
      ]
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lod", "bounds", "geometricErrorMetres", "courses", "layers"],
        "properties": {
          "id": { "$ref": "common-v2.schema.json#/$defs/tileId" },
          "lod": { "type": "integer", "minimum": 0, "maximum": 31 },
          "bounds": { "$ref": "common-v2.schema.json#/$defs/bounds" },
          "geometricErrorMetres": { "type": "number", "minimum": 0 },
          "courses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common-v2.schema.json#/$defs/id" }
          },
          "layers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["terrain", "surface", "objects"],
            "properties": {
              "terrain": { "$ref": "common-v2.schema.json#/$defs/assetReference" },
              "surface": {
                "anyOf": [
                  { "$ref": "common-v2.schema.json#/$defs/assetReference" },
                  { "type": "null" }
                ]
              },
              "objects": {
                "anyOf": [
                  { "$ref": "common-v2.schema.json#/$defs/assetReference" },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      }
    }
  }
}
