{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olovs-hemsida.invalid/schema/course-source-catalog-v1.json",
  "title": "Course source product catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "provider", "product", "homepage", "horizontalCrs",
          "verticalCrs", "licence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "provider": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string", "minLength": 1 },
          "horizontalCrs": { "type": ["string", "null"] },
          "verticalCrs": { "type": ["string", "null"] },
          "licence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "attribution", "redistribution", "derivatives",
              "reviewStatus", "notes"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "attribution": { "type": "string", "minLength": 1 },
              "redistribution": { "type": "string", "minLength": 1 },
              "derivatives": { "type": "string", "minLength": 1 },
              "reviewStatus": {
                "enum": ["approved", "pending", "blocked"]
              },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
